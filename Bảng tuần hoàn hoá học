    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        'cat-reactive-nonmetal': '#2a9d8f',
                        'cat-noble-gas': '#e76f51',
                        'cat-alkali-metal': '#e63946',
                        'cat-alkaline-earth': '#f4a261',
                        'cat-metalloid': '#2a6f97',
                        'cat-halogen': '#00b4d8',
                        'cat-post-transition': '#48cae4',
                        'cat-transition-metal': '#d4a373',
                        'cat-lanthanide': '#9b5de5',
                        'cat-actinide': '#f15bb5',
                        'cat-unknown': '#6c757d'
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #0f172a;
            color: #f8fafc;
        }

        /* Periodic Table Grid Layout */
        .periodic-table {
            display: grid;
            grid-template-columns: repeat(18, minmax(0, 1fr));
            gap: 4px;
        }

        .element-card {
            aspect-ratio: 1 / 1.1;
            transition: all 0.2s ease-in-out;
            cursor: pointer;
            position: relative;
            user-select: none;
        }

        .element-card:hover {
            transform: scale(1.15);
            z-index: 30;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5), 0 8px 10px -6px rgba(0, 0, 0, 0.5);
        }

        /* Category background colors */
        .bg-cat-reactive-nonmetal { background-color: rgba(42, 157, 143, 0.25); border-color: #2a9d8f; }
        .bg-cat-noble-gas { background-color: rgba(231, 111, 81, 0.25); border-color: #e76f51; }
        .bg-cat-alkali-metal { background-color: rgba(230, 57, 70, 0.25); border-color: #e63946; }
        .bg-cat-alkaline-earth { background-color: rgba(244, 162, 97, 0.25); border-color: #f4a261; }
        .bg-cat-metalloid { background-color: rgba(42, 111, 151, 0.25); border-color: #2a6f97; }
        .bg-cat-halogen { background-color: rgba(0, 180, 216, 0.25); border-color: #00b4d8; }
        .bg-cat-post-transition { background-color: rgba(72, 202, 228, 0.25); border-color: #48cae4; }
        .bg-cat-transition-metal { background-color: rgba(212, 163, 115, 0.25); border-color: #d4a373; }
        .bg-cat-lanthanide { background-color: rgba(155, 93, 229, 0.25); border-color: #9b5de5; }
        .bg-cat-actinide { background-color: rgba(241, 91, 181, 0.25); border-color: #f15bb5; }
        .bg-cat-unknown { background-color: rgba(108, 117, 125, 0.25); border-color: #6c757d; }

        .border-cat-reactive-nonmetal { border-color: #2a9d8f; }
        .border-cat-noble-gas { border-color: #e76f51; }
        .border-cat-alkali-metal { border-color: #e63946; }
        .border-cat-alkaline-earth { border-color: #f4a261; }
        .border-cat-metalloid { border-color: #2a6f97; }
        .border-cat-halogen { border-color: #00b4d8; }
        .border-cat-post-transition { border-color: #48cae4; }
        .border-cat-transition-metal { border-color: #d4a373; }
        .border-cat-lanthanide { border-color: #9b5de5; }
        .border-cat-actinide { border-color: #f15bb5; }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #0f172a;
        }
        ::-webkit-scrollbar-thumb {
            background: #334155;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #475569;
        }

        /* Print styles */
        @media print {
            body { background: white !important; color: black !important; }
            .no-print { display: none !important; }
            .print-only { display: block !important; }
            .qr-card-print { page-break-inside: avoid; break-inside: avoid; border: 1px solid #ccc !important; color: black !important; }
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between bg-slate-900 text-slate-100">

    <!-- Header Navigation -->
    <header class="bg-slate-800/80 backdrop-blur border-b border-slate-700 sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3">
