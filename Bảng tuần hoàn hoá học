        </div>
    </footer>

    <!-- ELEMENT DETAIL MODAL WITH QR CODE GENERATOR -->
    <div id="element-modal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-md z-50 hidden flex items-center justify-center p-4 overflow-y-auto">
