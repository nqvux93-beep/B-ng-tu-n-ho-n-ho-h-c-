            </div>

            <!-- Tab Selector -->
            <div class="flex bg-slate-900/60 p-1 rounded-xl border border-slate-700">
                <button id="tab-table-btn" onclick="switchTab('table')" class="px-4 py-1.5 rounded-lg text-sm font-medium transition-all bg-indigo-600 text-white shadow-sm">
                    <i class="fa-solid fa-table-cells mr-1.5"></i> Bảng Tuần Hoàn
                </button>
                <button id="tab-qr-btn" onclick="switchTab('qr')" class="px-4 py-1.5 rounded-lg text-sm font-medium text-slate-400 hover:text-white transition-all">
                    <i class="fa-solid fa-qrcode mr-1.5"></i> Quản lý 118 Mã QR
                </button>
            </div>
        </div>
    </header>

    <!-- Main Content Container -->
    <main class="max-w-7xl mx-auto px-2 sm:px-4 lg:px-8 py-6 flex-grow w-full">

        <!-- TAB 1: INTERACTIVE PERIODIC TABLE -->
        <section id="tab-table" class="space-y-6">
            
            <!-- Filter & Search Controls -->
            <div class="bg-slate-800/60 rounded-2xl p-4 border border-slate-700/60 flex flex-col md:flex-row gap-4 items-center justify-between">
                
                <!-- Search Box -->
                <div class="relative w-full md:w-80">
                    <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"></i>
                    <input type="text" id="search-input" placeholder="Tìm theo tên, ký hiệu, số Z..." 
                        class="w-full pl-10 pr-4 py-2 bg-slate-900/80 border border-slate-700 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 text-slate-100 placeholder-slate-500">
                </div>

                <!-- Group Filters -->
                <div class="flex flex-wrap gap-1.5 items-center justify-center md:justify-end text-xs">
                    <button onclick="filterCategory('all')" class="cat-filter-btn active bg-slate-700 hover:bg-slate-600 text-white px-3 py-1.5 rounded-lg border border-slate-600 font-medium transition">Tất cả</button>
                    <button onclick="filterCategory('alkali-metal')" class="cat-filter-btn bg-slate-800 hover:bg-slate-700 text-red-400 border border-red-500/30 px-2.5 py-1.5 rounded-lg font-medium transition">Kim loại kiềm</button>
                    <button onclick="filterCategory('alkaline-earth')" class="cat-filter-btn bg-slate-800 hover:bg-slate-700 text-orange-400 border border-orange-500/30 px-2.5 py-1.5 rounded-lg font-medium transition">Kiềm thổ</button>
                    <button onclick="filterCategory('transition-metal')" class="cat-filter-btn bg-slate-800 hover:bg-slate-700 text-amber-400 border border-amber-500/30 px-2.5 py-1.5 rounded-lg font-medium transition">Chuyển tiếp</button>
                    <button onclick="filterCategory('metalloid')" class="cat-filter-btn bg-slate-800 hover:bg-slate-700 text-sky-400 border border-sky-500/30 px-2.5 py-1.5 rounded-lg font-medium transition">Á kim</button>
                    <button onclick="filterCategory('reactive-nonmetal')" class="cat-filter-btn bg-slate-800 hover:bg-slate-700 text-emerald-400 border border-emerald-500/30 px-2.5 py-1.5 rounded-lg font-medium transition">Phi kim</button>
                    <button onclick="filterCategory('halogen')" class="cat-filter-btn bg-slate-800 hover:bg-slate-700 text-cyan-400 border border-cyan-500/30 px-2.5 py-1.5 rounded-lg font-medium transition">Halogen</button>
                    <button onclick="filterCategory('noble-gas')" class="cat-filter-btn bg-slate-800 hover:bg-slate-700 text-rose-400 border border-rose-500/30 px-2.5 py-1.5 rounded-lg font-medium transition">Khí hiếm</button>
                    <button onclick="filterCategory('lanthanide')" class="cat-filter-btn bg-slate-800 hover:bg-slate-700 text-purple-400 border border-purple-500/30 px-2.5 py-1.5 rounded-lg font-medium transition">Họ Lanthan</button>
                    <button onclick="filterCategory('actinide')" class="cat-filter-btn bg-slate-800 hover:bg-slate-700 text-pink-400 border border-pink-500/30 px-2.5 py-1.5 rounded-lg font-medium transition">Họ Actin</button>
                </div>
            </div>

            <!-- Periodic Table Display Wrapper -->
            <div class="overflow-x-auto pb-4">
                <div class="min-w-[1000px]">
                    <!-- Main Periodic Grid -->
                    <div id="periodic-table-grid" class="periodic-table mb-4">
                        <!-- Standard 1-7 periods dynamically inserted here -->
                    </div>

                    <!-- Lanthanides & Actinides Separate Blocks -->
                    <div class="mt-6 pl-[11.11%] space-y-1">
                        <div class="flex items-center mb-1">
                            <span class="text-xs text-purple-400 font-semibold w-24">Họ Lanthan (*):</span>
                            <div id="lanthanides-row" class="grid grid-cols-15 gap-1 flex-1"></div>
                        </div>
                        <div class="flex items-center">
                            <span class="text-xs text-pink-400 font-semibold w-24">Họ Actin (**):</span>
                            <div id="actinides-row" class="grid grid-cols-15 gap-1 flex-1"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Legend Section -->
            <div class="bg-slate-800/40 border border-slate-700/50 rounded-2xl p-4">
                <h3 class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-3">Chú thích phân loại nhóm nguyên tố</h3>
                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 lg:grid-cols-6 gap-2 text-xs">
                    <div class="flex items-center gap-2"><span class="w-3.5 h-3.5 rounded bg-cat-alkali-metal border border-red-500 inline-block"></span>Kim loại kiềm</div>
                    <div class="flex items-center gap-2"><span class="w-3.5 h-3.5 rounded bg-cat-alkaline-earth border border-orange-500 inline-block"></span>Kim loại kiềm thổ</div>
                    <div class="flex items-center gap-2"><span class="w-3.5 h-3.5 rounded bg-cat-transition-metal border border-amber-500 inline-block"></span>Kim loại chuyển tiếp</div>
                    <div class="flex items-center gap-2"><span class="w-3.5 h-3.5 rounded bg-cat-post-transition border border-teal-500 inline-block"></span>Kim loại yếu</div>
                    <div class="flex items-center gap-2"><span class="w-3.5 h-3.5 rounded bg-cat-metalloid border border-sky-500 inline-block"></span>Á kim</div>
                    <div class="flex items-center gap-2"><span class="w-3.5 h-3.5 rounded bg-cat-reactive-nonmetal border border-emerald-500 inline-block"></span>Phi kim đa nguyên tử</div>
                    <div class="flex items-center gap-2"><span class="w-3.5 h-3.5 rounded bg-cat-halogen border border-cyan-500 inline-block"></span>Halogen</div>
                    <div class="flex items-center gap-2"><span class="w-3.5 h-3.5 rounded bg-cat-noble-gas border border-rose-500 inline-block"></span>Khí hiếm</div>
                    <div class="flex items-center gap-2"><span class="w-3.5 h-3.5 rounded bg-cat-lanthanide border border-purple-500 inline-block"></span>Họ Lanthan</div>
                    <div class="flex items-center gap-2"><span class="w-3.5 h-3.5 rounded bg-cat-actinide border border-pink-500 inline-block"></span>Họ Actin</div>
                    <div class="flex items-center gap-2"><span class="w-3.5 h-3.5 rounded bg-cat-unknown border border-slate-500 inline-block"></span>Tổng hợp / Chưa rõ</div>
                </div>
            </div>
        </section>

        <!-- TAB 2: BULK QR CODE MANAGER & EXPORT -->
        <section id="tab-qr" class="hidden space-y-6">
            
            <!-- Controls Bar -->
            <div class="bg-slate-800/60 rounded-2xl p-4 border border-slate-700/60 flex flex-col md:flex-row gap-4 justify-between items-center no-print">
                <div class="flex items-center gap-3 w-full md:w-auto">
                    <input type="text" id="qr-search-input" placeholder="Tìm mã QR theo tên hoặc ký hiệu..." 
                        class="px-4 py-2 bg-slate-900/80 border border-slate-700 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 text-slate-100 placeholder-slate-500 w-full md:w-72">
                    <span id="qr-count-badge" class="text-xs bg-indigo-900/60 border border-indigo-700 text-indigo-300 font-medium px-3 py-1.5 rounded-xl whitespace-nowrap">
                        118 / 118 Nguyên Tố
                    </span>
                </div>

                <div class="flex items-center gap-3 w-full md:w-auto justify-end">
                    <button onclick="window.print()" class="px-4 py-2 bg-slate-700 hover:bg-slate-600 text-white text-sm font-medium rounded-xl transition flex items-center gap-2">
                        <i class="fa-solid fa-print"></i> In Bộ Thẻ QR
